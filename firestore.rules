rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // profilo di ogni giocatore: lo legge chiunque nel gioco, lo modifica solo il proprietario
    match /players/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    // numeri (nome-codice): unici; si creano solo per sé stessi e solo se liberi
    match /numbers/{key} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    // richieste: fidanzamento, proposta, matrimonio (con invitati), rottura
    match /requests/{id} {
      allow read: if request.auth != null && (resource.data.from == request.auth.uid
                                          || resource.data.to == request.auth.uid
                                          || request.auth.uid in resource.data.guests);
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid;
      allow update: if request.auth != null && (resource.data.to == request.auth.uid
                                            || resource.data.from == request.auth.uid);
    }
  }
}
